# Copy to .env and adjust for your deployment
IMAGE_REPOSITORY=rainoffallingstar/suncodexclaw
IMAGE_TAG=main
WORKSPACE_PATH=./workspace
HEALTH_PORT=8080
SUNCODEXCLAW_UID=1000
SUNCODEXCLAW_GID=1000
SUNCODEXCLAW_NO_RESTART=false
SUNCODEXCLAW_MAX_RESTARTS=20
SUNCODEXCLAW_RESTART_WINDOW=10m
SUNCODEXCLAW_FEISHU_RUNTIME=js
