# Copy to app.env and adjust for your bot/account config
# This file is injected into the container by docker compose via env_file.

# Feishu app credentials
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=your_app_secret
FEISHU_ENCRYPT_KEY=your_encrypt_key
FEISHU_VERIFICATION_TOKEN=your_verification_token

# Bot settings
FEISHU_BOT_NAME=飞书 Codex 助手
FEISHU_REPLY_PREFIX=AI 助手：
FEISHU_REQUIRE_MENTION=true
FEISHU_REQUIRE_MENTION_GROUP_ONLY=true

# Progress settings
FEISHU_PROGRESS_ENABLED=true
FEISHU_PROGRESS_MODE=doc
FEISHU_PROGRESS_DOC_TITLE_PREFIX=AI 助手｜任务进度

# Codex/OpenAI settings
FEISHU_CODEX_API_KEY=sk-xxxx
FEISHU_CODEX_BASE_URL=https://api.openai.com/v1
FEISHU_CODEX_CWD=/workspace
FEISHU_CODEX_MODEL=gpt-5.4
FEISHU_CODEX_REASONING_EFFORT=xhigh

# Optional alternatives also recognized by the runtime / wizard:
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# CODEX_API_KEY=sk-xxxx
