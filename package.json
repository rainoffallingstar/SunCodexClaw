{
  "name": "suncodexclaw",
  "version": "1.0.0",
  "description": "Feishu Codex assistant with Go native runtime, progress logs, and local attachment sending.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "go:configure": "GOCACHE=/tmp/suncodexclaw-gocache GOMODCACHE=/tmp/suncodexclaw-gomodcache go run ./cmd/suncodexclawd configure",
    "go:build": "bash tools/build_go_bins.sh",
    "feishu:ctl": "node -e \"console.error('use ./bin/suncodexclawd directly; example: ./bin/suncodexclawd status')\" && exit 1",
    "feishu:start": "./bin/suncodexclawd start",
    "feishu:stop": "./bin/suncodexclawd stop",
    "feishu:restart": "./bin/suncodexclawd restart",
    "feishu:status": "./bin/suncodexclawd status",
    "feishu:install-launchagents": "./bin/suncodexclawd launchagents install",
    "feishu:launchagents:status": "./bin/suncodexclawd launchagents status"
  }
}
